{
  "name": "CulinaryLog",
  "short_name": "CulinaryLog",
  "description": "Your personal recipe vault and daily cook log. Works offline; your data stays on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8f6f2",
  "theme_color": "#f8f6f2",
  "lang": "en",
  "dir": "ltr",
  "categories": ["food", "lifestyle", "productivity"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Log a dish",
      "short_name": "Log dish",
      "description": "Record what you cooked today",
      "url": "./log/?new=1",
      "icons": [{ "src": "icons/shortcut-log-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "New recipe",
      "short_name": "New recipe",
      "description": "Write down a new recipe",
      "url": "./recipe/edit/",
      "icons": [{ "src": "icons/shortcut-recipe-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Import recipe",
      "short_name": "Import",
      "description": "Paste a recipe from a website or message",
      "url": "./import/",
      "icons": [{ "src": "icons/shortcut-import-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./import/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
